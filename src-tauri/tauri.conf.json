{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileManager",
  "version": "0.2.0",
  "identifier": "io.filemanager.linux",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FileManager",
        "width": 1380,
        "height": 880,
        "minWidth": 900,
        "minHeight": 580,
        "center": true,
        "decorations": false,
        "backgroundColor": "#1e1e21",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: filemanager-media: http://filemanager-media.localhost https:; media-src 'self' filemanager-media: http://filemanager-media.localhost; frame-src 'self' filemanager-media: http://filemanager-media.localhost; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420; font-src 'self'; object-src 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["filemanager"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "A beautiful, capable file manager for Linux",
    "linux": {
      "deb": {
        "section": "utils",
        "desktopTemplate": "../packaging/filemanager.desktop.hbs",
        "recommends": [
          "ffmpeg",
          "poppler-utils",
          "libreoffice-core",
          "libreoffice-writer",
          "libreoffice-calc",
          "libreoffice-impress",
          "kdeconnect"
        ],
        "files": {
          "/usr/share/krunner/dbusplugins/filemanager-runner.desktop": "../packaging/filemanager-runner.desktop",
          "/usr/share/dbus-1/services/io.filemanager.Runner.service": "../packaging/io.filemanager.Runner.service"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
